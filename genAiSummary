import React, { useEffect, useState } from "react";
import axios from "axios";
import { useParams, useNavigate } from "react-router-dom";

const VariantListPage = () => {
  const { sampleId } = useParams();
  const [variants, setVariants] = useState([]);
  const [summary, setSummary] = useState("");
  const [showSummary, setShowSummary] = useState(false);
  const [selectedVariant, setSelectedVariant] = useState(null);
  const navigate = useNavigate();

  useEffect(() => {
    const fetchVariants = async () => {
      const res = await axios.get(`http://localhost:8000/variants/${sampleId}`);
      setVariants(res.data);
    };
    fetchVariants();
  }, [sampleId]);

  const handleSearch = (variant) => {
    const variantId = `${variant.chr}-${variant.position}-${variant.ref}-${variant.alt}`;
    navigate(`/variant-details/${sampleId}/${variantId}`);
  };

  const handleSummarize = async (variant) => {
    try {
      const res = await axios.post("http://localhost:5000/", variant);
      setSummary(res.data.summary || "No summary returned.");
      setSelectedVariant(variant);
      setShowSummary(true);
    } catch (error) {
      console.error("Error generating summary:", error);
      setSummary("Error generating summary.");
      setShowSummary(true);
    }
  };

  return (
    <div className="p-6 space-y-4 flex flex-col items-center">
      <h2 className="text-2xl font-bold">Variants in Sample: {sampleId}</h2>

      <table className="table-auto w-full max-w-6xl border border-gray-300">
        <thead className="bg-gray-100">
          <tr>
            {variants[0] &&
              Object.keys(variants[0])
                .filter((key) => key !== "id" && key !== "sample_id")
                .map((key) => (
                  <th key={key} className="px-4 py-2 border">
                    {key.replace(/_/g, " ")}
                  </th>
                ))}
            <th className="px-4 py-2 border">Actions</th>
          </tr>
        </thead>
        <tbody>
          {variants.map((variant, idx) => (
            <tr key={idx} className="border-t">
              {Object.entries(variant)
                .filter(([key]) => key !== "id" && key !== "sample_id")
                .map(([key, val]) => (
                  <td key={key} className="px-4 py-2 border">
                    {val}
                  </td>
                ))}
              <td className="px-4 py-2 border space-x-2">
                <button
                  onClick={() => handleSearch(variant)}
                  className="text-blue-500 hover:underline"
                  title="View Variant"
                >
                  🔍
                </button>
                <button
                  onClick={() => handleSummarize(variant)}
                  className="text-green-600 hover:underline"
                  title="Summarize Variant"
                >
                  🧠
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      {/* Summary Popup */}
      {showSummary && (
        <div className="bg-white shadow-md rounded-lg p-6 max-w-3xl w-full mt-6 border border-gray-300">
          <h3 className="text-lg font-semibold mb-2">Summary for Variant</h3>
          <p className="mb-4 font-mono text-sm">
            <strong>Variant:</strong>{" "}
            {selectedVariant &&
              `${selectedVariant.chr}-${selectedVariant.position}-${selectedVariant.ref}-${selectedVariant.alt}`}
          </p>
          <p className="whitespace-pre-wrap">{summary}</p>
          <button
            className="mt-4 px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600"
            onClick={() => setShowSummary(false)}
          >
            Close
          </button>
        </div>
      )}
    </div>
  );
};

export default VariantListPage;









