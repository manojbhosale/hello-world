	1. Docker build -t <image_tag> .  # docker file needs to be in same directory
	2. Docker run -it --name <container_name> --privileged -p 8001:8000 -d <image_name>
		a. -it <- interactive mode
		b. --privileged <- run command with admin access
		c. -p <host>:<local>
		d. -d detached more
	3. Docker rm <container name>
	4. Docker rmi <image name>


